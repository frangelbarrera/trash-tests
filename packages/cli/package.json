{
  "name": "@trash-tests/cli",
  "version": "1.0.0",
  "description": "Trash Tests command-line interface for JavaScript and TypeScript test quality checks.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "trashtests": "./dist/bin.js"
  },
  "files": ["dist"],
  "scripts": {
    "build": "node ../../scripts/clean-dist.mjs dist && tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@trash-tests/core": "workspace:*",
    "@trash-tests/reporters": "workspace:*",
    "jiti": "^2.4.2",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "vitest": "^4.1.11"
  }
}
