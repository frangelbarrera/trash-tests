{
  "name": "@trash-tests/reporters",
  "version": "1.0.0",
  "description": "Reusable reporters for Trash Tests analysis output in terminal, JSON, and Markdown.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "node ../../scripts/clean-dist.mjs dist && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@trash-tests/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "vitest": "^5.0.5"
  }
}
