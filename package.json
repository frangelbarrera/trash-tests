{
  "name": "trashtests-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Trash Tests monorepo — deterministic test-effectiveness checks for JavaScript and TypeScript.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=8.0.0"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "pnpm -r run typecheck",
    "calibrate": "tsx scripts/calibrate.ts",
    "check-score-stability": "tsx scripts/check-score-stability.ts",
    "check-release-version": "node scripts/check-release-version.mjs",
    "generate-rule-docs": "tsx scripts/generate-rule-docs.ts",
    "verify:package": "node scripts/smoke-pack.mjs",
    "verify": "pnpm lint && pnpm typecheck && pnpm build && pnpm test && pnpm check-score-stability && pnpm verify:package"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "@types/node": "^26.2.0",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2"
  }
}
